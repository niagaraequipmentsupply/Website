# Copy to .env.local for local dev. On Railway set these in the service Variables tab.
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URI=file:./payload.db          # Railway: file:/data/payload.db
# UPLOAD_DIR=/data/uploads              # Railway: keep media/documents on the volume
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX          # Google Analytics 4 measurement id
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/...   # optional: where quote/contact leads are POSTed

# ---- GoHighLevel (LeadConnector) CRM: contact + note + pipeline opportunity per website lead
# GHL_API_KEY=pit-…                 # Settings → Private Integrations (scopes: contacts.write, contacts.readonly, opportunities.write, locations.readonly)
# GHL_LOCATION_ID=…                 # sub-account id (Settings → Business Profile)
# GHL_SALES_PIPELINE_ID=…  GHL_SALES_STAGE_ID=…   # Equipment Sales pipeline + New Lead stage (npm run ghl:setup prints them)
# GHL_PARTS_PIPELINE_ID=…  GHL_PARTS_STAGE_ID=…   # Parts & Service pipeline + New Request stage
# GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/…   # alternative: a workflow Inbound Webhook trigger

# --- Forms, email and backups ---------------------------------------------------------------
# Cloudflare Turnstile (free bot check on every form). Create a widget at dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend (lead alerts + customer confirmations). Verify niagaraequipment.com in Resend, then set:
RESEND_API_KEY=
EMAIL_FROM=quotes@niagaraequipment.com
EMAIL_FROM_NAME=Niagara Equipment Supply
LEAD_NOTIFY_EMAIL=info@niagaraequipment.com
# Nightly backups: random secret shared with the GitHub Actions workflow (.github/workflows/backup.yml).
BACKUP_TOKEN=
